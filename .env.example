# --- LLM (first key set wins; leave all empty to run in offline "scripted" mode) ---
SUPERLINKED_API_KEY=          # Superlinked SIE Serverless ($20 free credits)
SUPERLINKED_SMART_MODEL=Qwen/Qwen3.8-27B-FP8
SUPERLINKED_FAST_MODEL=Qwen/Qwen3.8-27B-FP8         # Qwen/Qwen3.5-4B also works but cold-starts and is less reliable at JSON
OPENROUTER_API_KEY=           # if set, every model call goes through OpenRouter
OPENROUTER_SMART_MODEL=anthropic/claude-opus-5.5     # diagnosis, design, memos
OPENROUTER_FAST_MODEL=anthropic/claude-haiku-5.5     # monitoring notes (~40x cheaper per token)
ANTHROPIC_API_KEY=            # direct Anthropic API instead of OpenRouter
NORTHSTAR_SMART_MODEL=claude-opus-5-5   # hypotheses, design, decision memos
NORTHSTAR_FAST_MODEL=claude-haiku-5-5   # routine monitoring summaries
ARCEE_API_KEY=                # optional: route the fast tier to Arcee (see northstar/llm.py)

# --- Statsig (experiments + kill switches) ---
STATSIG_CONSOLE_KEY=          # Console API key (console-xxxx)

# --- Amplitude (event tracking) ---
AMPLITUDE_API_KEY=            # project API key for HTTP V2 ingestion

# --- SingleStore (event mirror + audit log). Empty = local SQLite ---
SINGLESTORE_URL=              # https://user:password@<workspace-host>:443/<db>  (HTTPS Data API; works behind proxies)

# --- Cognee Cloud (experiment memory knowledge graph). Empty = local memory table ---
COGNEE_API_KEY=
COGNEE_BASE_URL=              # "API base URL" on platform.cognee.ai -> API Keys, e.g. https://tenant-xxxx.aws.cognee.ai

# --- Demo ---
NORTHSTAR_DEMO_TRAP=1         # add a stakeholder "hide pricing" variant so the guardrail kill happens on stage

# --- Hosting ---
# NORTHSTAR_SQLITE_PATH=/tmp/northstar.db   # only needed on read-only hosts without SingleStore
