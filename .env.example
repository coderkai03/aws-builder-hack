# --- LLM ---
ANTHROPIC_API_KEY=            # leave empty to run in offline "scripted" mode
NORTHSTAR_SMART_MODEL=claude-opus-5-5   # hypotheses, design, decision memos
NORTHSTAR_FAST_MODEL=claude-haiku-5-5   # routine monitoring summaries
ARCEE_API_KEY=                # optional: route the fast tier to Arcee (see northstar/llm.py)

# --- Statsig (experiments + kill switches) ---
STATSIG_CONSOLE_KEY=          # Console API key (console-xxxx)

# --- Amplitude (event tracking) ---
AMPLITUDE_API_KEY=            # project API key for HTTP V2 ingestion

# --- SingleStore (event mirror + audit log). Empty = local SQLite ---
SINGLESTORE_URL=              # e.g. user:password@host:3306/northstar

# --- Cognee (experiment memory). Empty = local memory table ---
COGNEE_ENABLED=
